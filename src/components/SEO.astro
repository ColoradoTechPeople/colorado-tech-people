---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  robots?: string;
  includeCanonical?: boolean;
  ogType?: "website" | "article";
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  robots,
  includeCanonical = true,
  ogType = "website",
} = Astro.props;

if (!Astro.site) {
  throw new Error("Astro site is not configured. Check PUBLIC_SITE_URL validation in astro.config.mjs.");
}

function resolveUrl(value: string | undefined, fallback: string) {
  try {
    return new URL(value || fallback, Astro.site).toString();
  } catch {
    return new URL(fallback, Astro.site).toString();
  }
}

const resolvedCanonicalUrl = resolveUrl(canonicalUrl, Astro.url.pathname);
const resolvedOgImage = resolveUrl(ogImage, "/");
---

<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}
{includeCanonical && <link rel="canonical" href={resolvedCanonicalUrl} />}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={resolvedCanonicalUrl} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:site_name" content="Colorado Tech People" />
<meta property="og:locale" content="en_US" />
