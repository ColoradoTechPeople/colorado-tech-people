---
import type { EpisodeBase } from "@lib/episodes";
import { cleanString } from "@lib/episodes";
import applePodcastsIcon from "../../assets/platform-icons/apple-podcasts.png";
import spotifyIcon from "../../assets/platform-icons/spotify.png";
import youtubeIcon from "../../assets/platform-icons/youtube.png";

interface Props {
  episode?: EpisodeBase | null;
}

const { episode } = Astro.props;
const title = cleanString(episode?.title) || "this episode";
const platformLinks = [
  { label: "Apple Podcasts", href: cleanString(episode?.applePodcastsUrl), icon: "apple", iconSrc: applePodcastsIcon.src },
  { label: "Spotify", href: cleanString(episode?.spotifyUrl), icon: "spotify", iconSrc: spotifyIcon.src },
  { label: "YouTube", href: cleanString(episode?.youtubeUrl), icon: "youtube", iconSrc: youtubeIcon.src },
].filter((link) => link.href);

const getIframeSrcFromEmbedCode = (code?: string) => {
  const safeCode = cleanString(code);
  if (!safeCode) return null;
  const srcMatch = safeCode.match(/src=["']([^"']+)["']/i);
  return cleanString(srcMatch?.[1]) || null;
};

const embedSrc = cleanString(episode?.riversideEmbedUrl) || getIframeSrcFromEmbedCode(episode?.riversideEmbedCode);
---

<section class="episode-player" aria-label="Listen to this episode">
  {embedSrc ? (
    <div class="episode-player__embed">
      <iframe
        src={embedSrc}
        title={`Embedded player for ${episode?.title || "episode"}`}
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      />
    </div>
  ) : (
    <p class="episode-player__fallback">
      Episode trailer is COMING SOON!
    </p>
  )}

  {platformLinks.length > 0 && (
    <ul class="episode-player__links">
      {platformLinks.map((link) => (
        <li>
          <a
            class:list={["episode-card__platform-link", `episode-card__platform-link--${link.icon}`]}
            href={link.href}
            target="_blank"
            rel="noreferrer"
            aria-label={`Listen to ${title} on ${link.label}`}
          >
            <img
              class:list={["episode-card__platform-logo", `episode-card__platform-logo--${link.icon}`]}
              src={link.iconSrc}
              alt=""
              loading="lazy"
              aria-hidden="true"
            />
          </a>
        </li>
      ))}
    </ul>
  )}
</section>
