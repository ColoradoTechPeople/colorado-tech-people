---
interface Props {
  href?: string;
  label?: string;
}

const { href = "/", label = "Colorado Tech People" } = Astro.props;
---

<a class="site-wordmark" href={href} aria-label={label}>
  <span class="site-wordmark__eyebrow">Colorado</span>
  <span class="site-wordmark__name">Tech People</span>
</a>
