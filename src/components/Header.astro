---
import Container from "@components/Container.astro";
import Wordmark from "@components/Wordmark.astro";
import minimalLogo from "../../assets/Logo_minimal.png";

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  siteName?: string;
  currentPath?: string;
}

const { siteName = "Colorado Tech People", currentPath = "/" } = Astro.props;

const desktopNavLinks: NavLink[] = [
  { href: "/episodes", label: "Episodes" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const mobileNavLinks: NavLink[] = [
  { href: "/", label: "Home" },
  ...desktopNavLinks,
  { href: "/suggest-a-guest", label: "Suggest a Guest" },
  { href: "/sponsor-the-show", label: "Sponsor the Show" },
];

const isCurrent = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class="site-header">
  <Container as="div" class="site-header__inner">
    <a class="site-header__logo" href="/" aria-label={siteName}>
      <img
        src={minimalLogo.src}
        width={minimalLogo.width}
        height={minimalLogo.height}
        alt=""
        loading="eager"
        decoding="async"
      />
    </a>

    <div class="site-header__brand">
      <Wordmark href="/" label={siteName} />
    </div>

    <details class="site-nav-mobile">
      <summary aria-label="Toggle menu">Menu</summary>
      <nav aria-label="Primary" class="site-nav-mobile__panel">
        <ul class="site-nav site-nav--mobile">
          {
            mobileNavLinks.map((link) => (
              <li>
                <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <nav aria-label="Primary" class="site-nav-desktop">
      <ul class="site-nav">
        {
          desktopNavLinks.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="button-link button-link--primary site-header__cta" href="/suggest-a-guest">
      Suggest a Guest
    </a>
  </Container>
</header>
