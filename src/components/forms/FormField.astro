---
interface SelectOption {
  label: string;
  value: string;
  disabled?: boolean;
}

interface Props {
  id: string;
  name: string;
  label: string;
  type?: "text" | "email" | "textarea" | "select";
  value?: string;
  autocomplete?: string;
  placeholder?: string;
  prompt?: string;
  required?: boolean;
  disabled?: boolean;
  rows?: number;
  minlength?: number;
  maxlength?: number;
  options?: SelectOption[];
  helperText?: string;
  errorText?: string;
  class?: string;
}

const {
  id,
  name,
  label,
  type = "text",
  value,
  autocomplete,
  placeholder,
  prompt,
  required = false,
  disabled = false,
  rows = 6,
  minlength,
  maxlength,
  options = [],
  helperText,
  errorText,
  class: className,
} = Astro.props;

const helperId = helperText ? `${id}-helper` : undefined;
const errorId = errorText ? `${id}-error` : undefined;
const describedBy = [helperId, errorId].filter(Boolean).join(" ") || undefined;
---

<div class:list={["form-field", className]}>
  <label class="form-label" for={id}>
    {label}
    {required && <span class="form-required" aria-hidden="true">*</span>}
    {required && <span class="visually-hidden"> (required)</span>}
  </label>

  {type === "textarea" ? (
    <textarea
      class="form-control form-control--textarea"
      id={id}
      name={name}
      rows={rows}
      placeholder={placeholder}
      required={required}
      disabled={disabled}
      minlength={minlength}
      maxlength={maxlength}
      aria-describedby={describedBy}
      aria-invalid={errorText ? "true" : undefined}
    >{value}</textarea>
  ) : type === "select" ? (
    <select
      class="form-control form-control--select"
      id={id}
      name={name}
      required={required}
      disabled={disabled}
      aria-describedby={describedBy}
      aria-invalid={errorText ? "true" : undefined}
    >
      {prompt && <option value="" selected={!value} disabled={required}>{prompt}</option>}
      {options.map((option) => (
        <option value={option.value} selected={option.value === value} disabled={option.disabled}>
          {option.label}
        </option>
      ))}
    </select>
  ) : (
    <input
      class="form-control"
      id={id}
      name={name}
      type={type}
      value={value}
      autocomplete={autocomplete}
      placeholder={placeholder}
      required={required}
      disabled={disabled}
      minlength={minlength}
      maxlength={maxlength}
      aria-describedby={describedBy}
      aria-invalid={errorText ? "true" : undefined}
    />
  )}

  {helperText && <p class="form-helper" id={helperId}>{helperText}</p>}
  {errorText && <p class="form-error" id={errorId}>{errorText}</p>}
</div>
