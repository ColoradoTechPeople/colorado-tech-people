---
interface Props {
  id: string;
  name: string;
  label: string;
  value?: string;
  checked?: boolean;
  required?: boolean;
  helperText?: string;
  errorText?: string;
  class?: string;
}

const {
  id,
  name,
  label,
  value = "yes",
  checked = false,
  required = false,
  helperText,
  errorText,
  class: className,
} = Astro.props;

const helperId = helperText ? `${id}-helper` : undefined;
const errorId = errorText ? `${id}-error` : undefined;
const describedBy = [helperId, errorId].filter(Boolean).join(" ") || undefined;
---

<div class:list={["form-field form-field--checkbox", className]}>
  <div class="form-checkbox">
    <input
      id={id}
      name={name}
      type="checkbox"
      value={value}
      checked={checked}
      required={required}
      aria-describedby={describedBy}
      aria-invalid={errorText ? "true" : undefined}
    />
    <label for={id}>
      {label}
      {required && <span class="form-required" aria-hidden="true">*</span>}
      {required && <span class="visually-hidden"> (required)</span>}
    </label>
  </div>
  {helperText && <p class="form-helper" id={helperId}>{helperText}</p>}
  {errorText && <p class="form-error" id={errorId}>{errorText}</p>}
</div>
