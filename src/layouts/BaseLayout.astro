---
import "@styles/global.css";
import SEO from "@components/SEO.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import GoogleAnalytics from "@components/GoogleAnalytics.astro";
import { sanityClient } from "@lib/sanity/client";
import { siteSettingsQuery } from "@lib/sanity/queries";
import { cleanString } from "@lib/episodes";
import { firstMetadataText, resolveOgImage, resolvePageTitle } from "@lib/episode-seo.mjs";
import fallbackOgImage from "../../assets/logo.png";

interface ExternalLink {
  label: string;
  url: string;
}

interface SiteSettings {
  siteName?: string;
  podcastName?: string;
  positioningStatement?: string;
  defaultSeoTitle?: string;
  defaultSeoDescription?: string;
  defaultOgImage?: {
    asset?: {
      url?: string;
    };
  };
  podcastPlatformLinks?: ExternalLink[];
  socialLinks?: ExternalLink[];
}

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  completeTitle?: boolean;
  robots?: string;
  includeCanonical?: boolean;
  ogType?: "website" | "article";
}

const fallbackSiteName = "Colorado Tech People";
const fallbackDescription =
  "Colorado Tech People is an editorial podcast spotlighting the builders, operators, and ideas shaping Colorado tech.";

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  completeTitle = false,
  robots,
  includeCanonical = true,
  ogType = "website",
} = Astro.props;

let siteSettings: SiteSettings | null = null;

if (sanityClient) {
  try {
    siteSettings = await sanityClient.fetch<SiteSettings>(siteSettingsQuery);
  } catch {
    siteSettings = null;
  }
}

const siteName = cleanString(siteSettings?.siteName) || fallbackSiteName;
const positioningStatement = cleanString(siteSettings?.positioningStatement) || fallbackDescription;
const resolvedTitle = resolvePageTitle({
  title,
  defaultTitle: siteSettings?.defaultSeoTitle,
  siteName: fallbackSiteName,
  completeTitle,
});
const resolvedDescription = firstMetadataText([
  description,
  siteSettings?.defaultSeoDescription,
  fallbackDescription,
]);
const resolvedOgImage = resolveOgImage({
  pageImage: ogImage,
  defaultImage: siteSettings?.defaultOgImage?.asset?.url,
  fallbackImage: fallbackOgImage.src,
});
const podcastPlatformLinks = (siteSettings?.podcastPlatformLinks ?? [])
  .map((link) => ({ label: cleanString(link?.label), url: cleanString(link?.url) }))
  .filter((link) => link.label && link.url);
const socialLinks = (siteSettings?.socialLinks ?? [])
  .map((link) => ({ label: cleanString(link?.label), url: cleanString(link?.url) }))
  .filter((link) => link.label && link.url);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{resolvedTitle}</title>
    <SEO
      title={resolvedTitle}
      description={resolvedDescription}
      canonicalUrl={canonicalUrl}
      ogImage={resolvedOgImage}
      robots={robots}
      includeCanonical={includeCanonical}
      ogType={ogType}
    />
    <GoogleAnalytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <Header siteName={siteName} currentPath={currentPath} />

    <main id="main-content">
      <slot />
    </main>

    <Footer
      siteName={siteName}
      positioningStatement={positioningStatement}
      podcastPlatformLinks={podcastPlatformLinks}
      socialLinks={socialLinks}
      currentPath={currentPath}
    />
  </body>
</html>
