---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/Container.astro";
import EpisodeCard from "@components/EpisodeCard.astro";
import JsonLd from "@components/JsonLd.astro";
import podcastHeroImage from "../../assets/Podcast Hero.png";
import podcastLogo from "../../assets/logo.png";
import applePodcastsIcon from "../../assets/platform-icons/apple-podcasts.png";
import spotifyIcon from "../../assets/platform-icons/spotify.png";
import youtubeIcon from "../../assets/platform-icons/youtube.png";
import { sanityClient } from "@lib/sanity/client";
import { featuredEpisodeQuery, recentEpisodesQuery, siteSettingsQuery } from "@lib/sanity/queries";
import { cleanString, formatPublishDate, getEpisodeImageAlt, getEpisodeImageUrl } from "@lib/episodes";
import type { EpisodeBase } from "@lib/episodes";
import { absoluteHttpUrl, publicPodcastFeedUrl } from "@lib/json-ld.mjs";

interface ExternalLink { label?: string; url?: string; }
interface SiteSettings {
  positioningStatement?: string;
  logo?: { asset?: { url?: string } };
  riversideRssUrl?: string;
  podcastPlatformLinks?: ExternalLink[];
}

const productionOrigin = "https://www.coloradotechpeople.com";
const siteUrl = `${productionOrigin}/`;
const podcastDescription =
  "Conversations with founders, operators, builders, and innovators across Colorado — sharing real stories, lessons learned, and the future we’re building together.";
const podcastSameAs = [
  "https://open.spotify.com/show/1J6Hfb3PTsEkUvYYFf8bNm",
  "https://www.youtube.com/playlist?list=PL1MavnQcsbGAvnP2f7Q-Vq6LB4fXVf4De",
  "https://podcasts.apple.com/podcast/id1893439868",
];

const platformIconConfig = [
  { match: "apple", icon: "apple", iconSrc: applePodcastsIcon.src },
  { match: "spotify", icon: "spotify", iconSrc: spotifyIcon.src },
  { match: "youtube", icon: "youtube", iconSrc: youtubeIcon.src },
];

const getPlatformIcon = (label: string) =>
  platformIconConfig.find((platform) => label.toLowerCase().includes(platform.match));

const fallbackPositioningStatement =
  "An editorial podcast spotlighting the people, companies, and ideas shaping the Colorado tech ecosystem.";

let siteSettings: SiteSettings | null = null;
let featuredEpisode: EpisodeBase | null = null;
let recentEpisodes: EpisodeBase[] = [];

if (sanityClient) {
  try {
    siteSettings = await sanityClient.fetch<SiteSettings>(siteSettingsQuery);
    featuredEpisode = await sanityClient.fetch<EpisodeBase | null>(featuredEpisodeQuery);
    recentEpisodes = await sanityClient.fetch<EpisodeBase[]>(recentEpisodesQuery, {
      excludeId: featuredEpisode?._id ?? null,
    });
  } catch {
    siteSettings = null;
    featuredEpisode = null;
    recentEpisodes = [];
  }
}

const positioningStatement = siteSettings?.positioningStatement?.trim() || fallbackPositioningStatement;
const platformLinks = (siteSettings?.podcastPlatformLinks ?? [])
  .map((link) => ({ label: cleanString(link?.label), url: cleanString(link?.url) }))
  .filter((link) => link.label && link.url)
  .map((link) => ({ ...link, ...getPlatformIcon(link.label) }));
const featuredDate = formatPublishDate(featuredEpisode?.publishDate);
const featuredImage = getEpisodeImageUrl(featuredEpisode);
const featuredImageAlt = getEpisodeImageAlt(featuredEpisode);
const featuredStamp = [featuredDate, featuredEpisode?.episodeNumber ? `Episode ${featuredEpisode.episodeNumber}` : ""]
  .filter(Boolean)
  .join(" · ");
const homeRecentEpisodes = recentEpisodes.slice(0, 3);
const pageTitle = "Colorado Tech People | Stories Shaping Colorado Tech";
const podcastImage =
  absoluteHttpUrl(siteSettings?.logo?.asset?.url) || new URL(podcastLogo.src, siteUrl).toString();
const podcastFeed = publicPodcastFeedUrl(siteSettings?.riversideRssUrl);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Colorado Tech People",
      description: positioningStatement,
    },
    {
      "@type": "PodcastSeries",
      "@id": `${siteUrl}#podcast`,
      url: siteUrl,
      name: "Colorado Tech People",
      description: podcastDescription,
      inLanguage: "en-US",
      image: podcastImage,
      sameAs: podcastSameAs,
      ...(podcastFeed ? { webFeed: podcastFeed } : {}),
    },
  ],
};

---

<BaseLayout title={pageTitle} description={positioningStatement} completeTitle>
  <JsonLd data={structuredData} />
  <section class="home-hero">
    <Container as="div" class="home-hero__inner">
      <div class="home-hero__copy">
        <h1>
          Stories, insights, and voices shaping <span class="home-hero__accent">Colorado tech.</span>
        </h1>
        <p class="home-hero__lede">{positioningStatement}</p>
        <div class="home-hero__actions">
          <a class="button-link button-link--primary" href="/episodes">Browse Episodes</a>
        </div>
      </div>

      <div class="home-hero__art home-hero__art--image">
        <div class="home-hero__image-frame">
          <img
            src={podcastHeroImage.src}
            width={podcastHeroImage.width}
            height={podcastHeroImage.height}
            alt="Colorado Tech People podcast hero artwork"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </Container>
  </section>

  <Container as="section" class="home-featured" aria-label="Featured episode">
    {featuredEpisode?.slug ? (
      <div class="home-featured__panel">
        <div class="home-featured__header">
          <p class="home-featured__label">Featured Episode</p>
          {featuredStamp && <span class="home-featured__stamp">{featuredStamp}</span>}
        </div>

        <div class="home-featured__grid">
          <div class="home-featured__media">
            <img
              src={featuredImage}
              alt={featuredImageAlt}
              loading="lazy"
            />
          </div>
          <div class="home-featured__content">
            <EpisodeCard episode={featuredEpisode} featured />
          </div>
        </div>
      </div>
    ) : (
      <div class="episode-card episode-card--empty">
        <p>No published episodes are available yet. Check back soon for new conversations.</p>
      </div>
    )}
  </Container>

  <Container as="section" class="home-recent" aria-labelledby="recent-episodes-heading">
    <div class="home-section-heading">
      <h2 id="recent-episodes-heading">Recent Conversations</h2>
    </div>

    {homeRecentEpisodes.length > 0 ? (
      <ul class="episode-grid">
        {homeRecentEpisodes.map((episode) => (
          <li><EpisodeCard episode={episode} /></li>
        ))}
      </ul>
    ) : (
      <p>More published episodes will appear here as they go live.</p>
    )}
  </Container>

  <Container as="section" class="home-editorial-panels">
    <div class="home-editorial-panels__grid">
      <div class="editorial-panel editorial-panel--dark">
        <h2>The Decisions, Failures, and Breakthroughs Behind Product, AI, and Startup Innovation</h2>
        <p>
          Go behind the scenes with founders, product leaders, and technology innovators as they share the hard lessons,
          failures that became stepping stones to success, strategy, tradeoffs, and the decisions that shaped their
          journey and their companies.
        </p>
        <a class="button-link button-link--primary" href="/episodes">Browse Episodes</a>
      </div>
    </div>
  </Container>

  <section class="home-subscribe-band" aria-labelledby="subscribe-heading">
    <Container as="div" class="home-subscribe-band__inner">
      <div>
        <p class="home-kicker">Never Miss An Episode</p>
        <h2 id="subscribe-heading">Subscribe Wherever You Listen</h2>
        <p>Follow on your preferred platform today. Newsletter signup is coming soon.</p>
      </div>

      {platformLinks.length > 0 ? (
        <ul class="home-subscribe-band__links">
          {platformLinks.map((link) => (
            <li>
              <a
                class:list={[
                  "home-subscribe-band__link",
                  link.icon && "episode-card__platform-link",
                  link.icon && `episode-card__platform-link--${link.icon}`,
                ]}
                href={link.url}
                aria-label={`Listen on ${link.label}`}
              >
                {link.iconSrc ? (
                  <img
                    class:list={["episode-card__platform-logo", `episode-card__platform-logo--${link.icon}`]}
                    src={link.iconSrc}
                    alt=""
                    loading="lazy"
                    aria-hidden="true"
                  />
                ) : (
                  <span>{link.label}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="home-subscribe-band__placeholder">
          Platform links will appear here once connected in site settings.
        </p>
      )}
    </Container>
  </section>
</BaseLayout>
