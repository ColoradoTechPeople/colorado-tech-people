---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/Container.astro";
import EpisodeCard from "@components/EpisodeCard.astro";
import { sanityClient } from "@lib/sanity/client";
import { allPublishedEpisodesQuery } from "@lib/sanity/queries";
import type { EpisodeBase } from "@lib/episodes";

let episodes: EpisodeBase[] = [];

if (sanityClient) {
  try {
    episodes = await sanityClient.fetch<EpisodeBase[]>(allPublishedEpisodesQuery);
    episodes = episodes.sort((a, b) => {
      const aTime = a.publishDate ? new Date(a.publishDate).getTime() : 0;
      const bTime = b.publishDate ? new Date(b.publishDate).getTime() : 0;
      return bTime - aTime;
    });
  } catch {
    episodes = [];
  }
}

const featuredEpisode = episodes[0] ?? null;
const archiveEpisodes = episodes.slice(1);
---

<BaseLayout title="Episodes | Colorado Tech People">
  <Container as="section" class="listing-hero">
    <div class="page-intro page-intro--narrow">
      <p class="eyebrow">Colorado Tech People</p>
      <h1>Published conversations with Colorado builders, operators, and founders.</h1>
      <p>Browse the latest episodes in a clean archive built for reading first and listening second.</p>
    </div>
  </Container>

  {featuredEpisode?.slug && (
    <Container as="section" class="listing-featured" aria-labelledby="latest-episode-heading">
      <div class="home-section-heading">
        <div>
          <p class="home-kicker">Latest Episode</p>
          <h2 id="latest-episode-heading">Start here</h2>
        </div>
      </div>
      <EpisodeCard episode={featuredEpisode} featured />
    </Container>
  )}

  <Container as="section" class="listing-archive" aria-labelledby="episode-archive-heading">
    <div class="home-section-heading">
      <div>
        <p class="home-kicker">Episode Archive</p>
        <h2 id="episode-archive-heading">All published episodes</h2>
      </div>
    </div>

    {episodes.length > 0 ? (
      (featuredEpisode ? archiveEpisodes : episodes).length > 0 ? (
        <ul class="episode-grid episode-grid--stacked">
          {(featuredEpisode ? archiveEpisodes : episodes).map((episode) => <li><EpisodeCard episode={episode} /></li>)}
        </ul>
      ) : (
        <div class="episode-card episode-card--empty">
          <p>More published episodes will appear here as the archive grows.</p>
        </div>
      )
    ) : (
      <div class="episode-card episode-card--empty">
        <p>No published episodes are available yet. Check back soon.</p>
      </div>
    )}
  </Container>
</BaseLayout>
