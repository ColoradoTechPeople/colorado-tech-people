---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/Container.astro";
import EpisodeCard from "@components/EpisodeCard.astro";
import { sanityClient } from "@lib/sanity/client";
import { allPublishedEpisodesQuery } from "@lib/sanity/queries";
import type { EpisodeBase } from "@lib/episodes";

let episodes: EpisodeBase[] = [];

if (sanityClient) {
  try {
    episodes = await sanityClient.fetch<EpisodeBase[]>(allPublishedEpisodesQuery);
    episodes = episodes.sort((a, b) => {
      const aTime = a.publishDate ? new Date(a.publishDate).getTime() : 0;
      const bTime = b.publishDate ? new Date(b.publishDate).getTime() : 0;
      return bTime - aTime;
    });
  } catch {
    episodes = [];
  }
}

---

<BaseLayout title="Episodes | Colorado Tech People">
  <section class="page-hero listing-hero">
    <Container as="div" class="page-hero__inner">
      <div class="page-intro">
        <p class="eyebrow">Episode Archive</p>
        <h1>All published episodes</h1>
        <p>Dive into conversations with the founders, builders, and product leaders shaping the future of Colorado tech—one hard decision, bold idea, and real-world breakthrough at a time.</p>
      </div>
    </Container>
  </section>

  <Container as="section" class="listing-archive">
    {episodes.length > 0 ? (
      <ul class="episode-grid episode-grid--stacked">
        {episodes.map((episode) => <li><EpisodeCard episode={episode} /></li>)}
      </ul>
    ) : (
      <div class="episode-card episode-card--empty">
        <p>No published episodes are available yet. Check back soon.</p>
      </div>
    )}
  </Container>
</BaseLayout>
